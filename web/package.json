{
  "name": "gpt4-langchain-pdf-chatbot",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "flask-dev": "FLASK_DEBUG=1 pip3 install -r requirements.txt && python3 -m flask --app api/bot run -p 5328 --debugger --reload",
    "next-dev": "next dev",
    "dev": "concurrently \"pnpm run next-dev\" \"pnpm run flask-dev\"",
    "build": "next build",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "lint": "eslint --ignore-path .gitignore \"**/*.+(ts|js|tsx)\"",
    "format": "prettier --ignore-path .gitignore \"**/*.+(ts|js|tsx)\" --write",
    "ingest": "tsx -r dotenv/config scripts/ingest-data.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "@microsoft/fetch-event-source": "^2.0.1",
    "@mui/material": "^5.13.3",
    "@pinecone-database/pinecone": "0.0.14",
    "@radix-ui/react-accordion": "^1.1.1",
    "@upstash/redis": "^1.22.0",
    "add": "^2.0.6",
    "axios": "^1.4.0",
    "bufferutil": "^4.0.7",
    "cheerio": "^1.0.0-rc.12",
    "concurrently": "^8.2.0",
    "d3-dsv": "^3.0.1",
    "dotenv": "^16.0.3",
    "epub2": "^3.0.1",
    "graphql": "^16.7.1",
    "langchain": "^0.0.84",
    "lucide-react": "^0.125.0",
    "mammoth": "^1.6.0",
    "next": "^13.2.5-canary.26",
    "next-fonts": "^1.5.1",
    "pdf-parse": "1.1.1",
    "playwright": "^1.34.3",
    "puppeteer": "^20.5.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-icons": "^4.10.1",
    "react-markdown": "^8.0.5",
    "react-spinners": "^0.13.8",
    "react-wavify": "^1.8.2",
    "redis": "^4.6.7",
    "reset-css": "^5.0.1",
    "tailwind-merge": "^1.10.0",
    "url-metadata": "^3.0.1",
    "utf-8-validate": "^6.0.3",
    "weaviate-ts-client": "^1.3.3",
    "yarn": "^1.22.19"
  },
  "devDependencies": {
    "@playwright/test": "^1.34.3",
    "@types/node": "^18.14.6",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@typescript-eslint/parser": "^5.54.0",
    "autoprefixer": "^10.4.13",
    "eslint": "8.35.0",
    "eslint-config-next": "^13.2.5-canary.26",
    "postcss": "^8.4.21",
    "prettier": "^2.8.4",
    "tailwindcss": "^3.2.7",
    "tsx": "^3.12.3",
    "typescript": "^4.9.5",
    "webpack": "^5.84.1"
  }
}
