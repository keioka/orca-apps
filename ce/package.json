{
  "name": "Orca",
  "displayName": "__MSG_extensionName__",
  "version": "0.1.7",
  "description": "__MSG_extensionDescription__",
  "author": "Orca",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build --tag=staging",
    "build:zip": "plasmo build --zip --tag=staging",
    "test": "plasmo test",
    "cypress:open": "cypress open",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@ashwamegh/react-link-preview": "^0.3.0",
    "@dhaiwat10/react-link-preview": "^1.15.0",
    "@emotion/cache": "^11.11.0",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@highlight-run/react": "^3.2.1",
    "@lottiefiles/react-lottie-player": "^3.5.3",
    "@mui/icons-material": "^5.15.11",
    "@mui/material": "^5.14.7",
    "@mui/x-charts": "^6.19.5",
    "@mui/x-date-pickers": "^6.19.6",
    "@plasmohq/messaging": "^0.5.0",
    "@plasmohq/redux-persist": "^6.1.0",
    "@plasmohq/storage": "^1.8.0",
    "@reduxjs/toolkit": "^1.9.5",
    "@sentry/react": "^7.100.1",
    "@stripe/react-stripe-js": "^2.3.1",
    "@stripe/stripe-js": "^2.1.6",
    "axios": "^1.5.0",
    "firebase": "^10.4.0",
    "highlight.run": "^8.5.0",
    "link-preview-js": "^3.0.5",
    "lodash": "^4.17.21",
    "logrocket": "^8.0.1",
    "logrocket-react": "^6.0.3",
    "mixpanel-browser": "^2.49.0",
    "moment": "^2.30.1",
    "plasmo": "0.84.2",
    "react": "18.2.0",
    "react-dom": "^18.2.0",
    "react-error-boundary": "^4.0.12",
    "react-feature-flags": "^1.0.0",
    "react-icons": "^4.10.1",
    "react-redux": "^8.1.2",
    "react-router-dom": "^6.16.0",
    "react-type-animation": "^3.2.0",
    "react-typed": "^2.0.12",
    "redux-persist-webextension-storage": "^1.0.2",
    "rss-parser": "^3.13.0",
    "ulid": "^2.3.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.0",
    "@ladle/react": "^3.0.0",
    "@storybook/addon-essentials": "^7.4.2",
    "@storybook/addon-interactions": "^7.4.2",
    "@storybook/addon-links": "^7.4.2",
    "@storybook/addon-onboarding": "^1.0.8",
    "@storybook/blocks": "^7.4.2",
    "@storybook/react": "^7.4.2",
    "@storybook/react-vite": "^7.4.2",
    "@storybook/testing-library": "^0.2.1",
    "@types/chrome": "0.0.243",
    "@types/node": "20.5.0",
    "@types/react": "18.2.20",
    "@types/react-dom": "18.2.7",
    "cypress": "^13.6.6",
    "cypress-firebase": "^4.0.0",
    "firebase-admin": "^12.0.0",
    "prettier": "3.0.2",
    "storybook": "^7.4.2",
    "typescript": "5.1.6"
  },
  "pnpm": {
    "overrides": {
      "cosmiconfig": "8.2.0"
    }
  },
  "manifest": {
    "name": "__MSG_extensionName__",
    "default_locale": "ja",
    "key": "$CRX_PUBLIC_KEY",
    "web_accessible_resources": [
      {
        "resources": [
          "assets/icon.png"
        ],
        "matches": [
          "https://*/*",
          "http://*/*"
        ]
      }
    ],
    "host_permissions": [
      "https://orca-fullstack.vercel.app/*",
      "https://*/*"
    ],
    "permissions": [
      "identity",
      "tabs",
      "alarms",
      "notifications"
    ],
    "oauth2": {
      "client_id": "$PLASMO_PUBLIC_FIREBASE_CLIENT_ID",
      "scopes": [
        "https://www.googleapis.com/auth/userinfo.email",
        "https://www.googleapis.com/auth/userinfo.profile"
      ]
    }
  }
}
