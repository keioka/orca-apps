generator py {
  provider             = "prisma-client-py"
  recursive_type_depth = "-1"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Auth {
  id             String   @id @default(uuid())
  thirdPartyName String   @map("third_party_name")
  thirdPartyId   String   @unique @map("third_party_id")
  providerName   String   @map("provider_name")
  providerId     String   @unique @map("provider_id")
  user           User?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("auth")
}

model User {
  id       String   @id @default(uuid())
  username String
  authId   String   @unique @map("auth_id")
  Lesson   Lesson[]
  auth     Auth?    @relation(fields: [authId], references: [id], map: "auth")

  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  messages             Message[]
  savedVocabulary      S[]
  savedParaphrases     SavedParaphrase[]
  savedGrammarMistakes SavedGrammarMistake[]
  hashtags             FollowHashtag[]

  @@map("users")
}

model Material {
  id          Int      @id @default(autoincrement())
  name        String
  type        String
  category    String
  url         String   @unique
  imageUrl    String   @map("image_url")
  publishedAt DateTime @map("published_at")
  externalId  String   @unique @map("external_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lessons      Lesson[]
  summary      Summary[]
  vocabularies Vocabulary[]
  hashtags     MaterialHashtag[]

  publisherId Int       @map("publisher_id")
  publisher   Publisher @relation(fields: [publisherId], references: [id])

  @@map("materials")
}

model Publisher {
  id         Int        @id @default(autoincrement())
  name       String
  type       String // youtube & articles 
  url        String // youtube channel url & article url
  externalId String     @unique @map("external_id")
  material   Material[]
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  @@map("publishers")
}

model Summary {
  id         String   @id @default(uuid())
  name       String
  content    String
  materialId Int      @map("material_id")
  material   Material @relation(fields: [materialId], references: [id])
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("summaries")
}

model Vocabulary {
  id         String   @id @default(uuid())
  name       String
  word       String
  meaning    String
  materialId Int      @map("material_id")
  material   Material @relation(fields: [materialId], references: [id])
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  User       User?    @relation(fields: [userId], references: [id])
  userId     String?

  @@map("vocabularies")
}

model Lesson {
  id          Int       @id @default(autoincrement())
  initMessage Boolean   @default(false) @map("init_message")
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id])
  materialId  Int       @map("material_id")
  material    Material  @relation(fields: [materialId], references: [id])
  messages    Message[]
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([userId, materialId])
  @@map("lessons")
}

model Message {
  id          Int        @id @default(autoincrement())
  fullContent String     @map("full_content")
  sentences   Sentence[]
  lesson      Lesson?    @relation(fields: [lessonId], references: [id])
  lessonId    Int?       @map("lesson_id")
  type        String     @default("user")
  createdById String?    @map("created_by_id")
  createdBy   User?      @relation(fields: [createdById], references: [id])
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  audioFileId Int?       @map("audio_file_id")

  @@map("messages")
}

model Sentence {
  id              Int              @id @default(autoincrement())
  content         String
  Message         Message          @relation(fields: [messageId], references: [id])
  messageId       Int              @map("message_id")
  sentenceIndex   Int              @map("sentence_index")
  paraphrases     Paraphrase[]
  grammarMistakes GrammarMistake[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("sentences")
}

model Paraphrase {
  id         Int       @id @default(autoincrement())
  content    String
  type       String
  url        String
  sentenceId Int?      @map("sentence_id")
  sentence   Sentence? @relation(fields: [sentenceId], references: [id])

  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  SavedParaphrase SavedParaphrase[]

  @@map("paraphrases")
}

model SavedParaphrase {
  id           Int        @id @default(autoincrement())
  paraphraseId Int        @map("paraphrase_id")
  paraphrase   Paraphrase @relation(fields: [paraphraseId], references: [id])
  userId       String     @map("user_id")
  user         User       @relation(fields: [userId], references: [id])
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@map("saved_paraphrases")
}

model GrammarMistake {
  id         Int       @id @default(autoincrement())
  content    Json
  type       String
  url        String
  sentenceId Int?      @map("sentence_id")
  sentence   Sentence? @relation(fields: [sentenceId], references: [id])

  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")
  SavedGrammarMistake SavedGrammarMistake[]

  @@map("grammar_mistakes")
}

model SavedGrammarMistake {
  id               Int            @id @default(autoincrement())
  grammarMistakeId Int            @map("grammar_mistake_id")
  grammarMistake   GrammarMistake @relation(fields: [grammarMistakeId], references: [id])
  userId           String         @map("user_id")
  user             User           @relation(fields: [userId], references: [id])
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  @@map("saved_grammar_mistakes")
}

model Hashtag {
  id              Int               @id @default(autoincrement())
  name            String            @unique
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  MaterialHashtag MaterialHashtag[]
  FollowHashtag   FollowHashtag[]

  @@map("hashtags")
}

model MaterialHashtag {
  id         Int      @id @default(autoincrement())
  materialId Int      @map("material_id")
  material   Material @relation(fields: [materialId], references: [id])
  hashtagId  Int      @map("hashtag_id")
  hashtag    Hashtag  @relation(fields: [hashtagId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("material_hashtags")
}

model FollowHashtag {
  id        Int     @id @default(autoincrement())
  userId    String  @map("user_id")
  user      User    @relation(fields: [userId], references: [id])
  hashtagId Int     @map("hashtag_id")
  hashtag   Hashtag @relation(fields: [hashtagId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("follow_hashtags")
}

model AudioFile {
  id        Int      @id @default(autoincrement())
  path      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("audio_files")
}
