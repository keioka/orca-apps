{
  "name": "orca",
  "version": "1.0.0",
  "scripts": {
    "build": "expo prebuild; eas build -p ios --clear-cache --profile production",
    "build:local": "STAGE=prod expo prebuild; STAGE=prod eas build -p ios --clear-cache --profile production",
    "start": "expo start --dev-client",
    "start:ios": "STAGE=localdev npx expo run:ios",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "publish:update": "dotenv -e ./.env.update -- eas update --branch production",
    "publish:doctor": "dotenv -e ./.env.update -- echo $FIREBASE_PUBLIC_API_KEY;",
    "dotenv": "dotenv -e ./.env.update -p"
  },
  "dependencies": {
    "@bothrs/expo-mixpanel-analytics": "^2.0.3",
