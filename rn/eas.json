{
  "cli": {
    "version": ">= 3.5.1"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "resourceClass": "m1-medium"
      },
      "env": {
        "EXPO_PUBLIC_API_ROOT": "http://192.168.1.2:3000"
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "resourceClass": "m1-medium"
      },
      "env": {
        "EXPO_PUBLIC_API_ROOT": "https://orca-fullstack.vercel.app",
        "EXPO_PUBLIC_MIXPANEL_TOKEN": "2fdf9d171ac057571c525919e780789f",
        "EXPO_PUBLIC_APP_ENV": "preview"
      },
      "channel": "preview"
    },
    "production": {
      "developmentClient": false,
      "ios": {
        "resourceClass": "m1-medium"
      },
      "env": {
        "EXPO_PUBLIC_API_ROOT": "https://orca-fullstack.vercel.app",
        "EXPO_PUBLIC_MIXPANEL_TOKEN": "23cf25609bf525773992c3155a9f698a",
        "EXPO_PUBLIC_APP_ENV": "production"
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "companyName": "TaiHeyYo Inc."
      }
    }
  }
}