    "@microsoft/fetch-event-source": "^2.0.1",
    "@mui/material": "^5.13.3",
    "@prisma/client": "4.16.2",
    "@radix-ui/react-accordion": "^1.1.1",
    "@supabase/auth-helpers-nextjs": "^0.7.3",
    "@supabase/supabase-js": "^2.26.0",
    "add": "^2.0.6",
    "axios": "^1.4.0",
    "bufferutil": "^4.0.7",
    "cheerio": "^1.0.0-rc.12",
    "compromise": "^14.10.0",
    "cookie-parser": "^1.4.6",
    "cookies-next": "^2.1.2",
    "d3-dsv": "^3.0.1",
    "dotenv": "^16.0.3",
    "epub2": "^3.0.1",
    "firebase-admin": "^11.10.1",
    "graphql": "^16.7.1",
    "llama-node": "^0.1.6",
    "lucide-react": "^0.125.0",
    "next": "^13.4.13-canary.4",
    "next-fonts": "^1.5.1",
    "node-html-parser": "^6.1.9",
    "openai": "^4.7.1",
    "prisma": "4.16.2",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-icons": "^4.10.1",
    "react-markdown": "^8.0.5",
    "react-spinners": "^0.13.8",
