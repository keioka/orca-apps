{
  "name": "orca",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "18.x"
  },
  "scripts": {
    "flask-dev": "FLASK_DEBUG=1 pip3 install -r requirements.txt && python3 -m flask --app api/py/bot run -p 5328 --debugger --reload",
    "next-dev": "next dev",
    "dev": "concurrently --kill-others npm:dev:*",
    "dev:next": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "jest",
    "db:migrate": "prisma migrate dev --schema='./db/prisma/schema.prisma'",
    "db:rollback": "prisma migrate resolve --schema='./db/prisma/schema.prisma' --rolled-back",
    "type-check": "tsc --noEmit",
    "lint": "eslint --ignore-path .gitignore \"**/*.+(ts|js|tsx)\"",
    "format": "prettier --ignore-path .gitignore \"**/*.+(ts|js|tsx)\" --write",
    "ingest": "tsx -r dotenv/config scripts/ingest-data.ts",
    "postinstall": "prisma generate --schema='./db/prisma/schema.prisma' && PRISMA_SCHEMA_DISABLE_ADVISORY_LOCK=true prisma migrate deploy --schema='./db/prisma/schema.prisma'"
  },
