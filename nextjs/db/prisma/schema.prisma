// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

model Auth {
  id             String   @id @default(uuid()) @db.Char(36)
  thirdPartyName String   @map("third_party_name") @db.VarChar(255)
  thirdPartyId   String   @unique @map("third_party_id") @db.VarChar(255)
  providerName   String   @map("provider_name") @db.VarChar(255)
  providerId     String   @unique @map("provider_id") @db.VarChar(255)
  user           User?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("auth")
}

model User {
  id        String   @id @default(uuid()) @db.Char(36)
  username  String   @db.VarChar(255)
  authId    String   @unique @map("auth_id") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  auth                Auth?                 @relation(fields: [authId], references: [id], map: "auth")
  lessons             Lesson[]
  messages            Message[]
  savedParaphrase     SavedParaphrase[]
  savedGrammarMistake SavedGrammarMistake[]
  followRss           FollowRss[]
  savedVocabularies   SavedVocabularies[]
  hashtags            UserFollowHashtag[]

  @@map("users")
}

model Material {
  id               String    @id @default(uuid()) @db.Char(36)
  title            String    @db.VarChar(255)
  type             String    @db.VarChar(255)
  category         String?   @db.VarChar(100)
  categoryExternal String?   @map("category_external") @db.VarChar(255)
  url              String    @unique
  imageUrl         String?   @map("image_url")
  publishedAt      DateTime? @map("published_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lessons         Lesson[]
  summary         Summary[]
  vocabularies    Vocabulary[]
  publisherId     String            @map("publisher_id")
  publisher       Publisher         @relation(fields: [publisherId], references: [id])
  materialHashtag MaterialHashtag[]

  @@map("materials")
}

model Publisher {
  id                String      @id @default(uuid()) @db.Char(36)
  name              String      @db.VarChar(255)
  contentType       String      @map("content_type") @db.VarChar(32)
  publisherType     String      @map("publisher_type") @db.VarChar(32)
  rssUrl            String?     @unique @map("rss_url") @db.VarChar(255)
  domain            String?     @unique @map("domain") @db.VarChar(255)
  category          String?     @db.VarChar(100)
  categoryExternal  String?     @map("category_external") @db.VarChar(255)
  isActive          Boolean     @default(true) @map("is_active")
  isRecommended     Boolean     @default(false) @map("is_recommended")
  imageUrl          String?     @map("image_url")
  material          Material[]
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  followRss         FollowRss[]
  lastCrawledAt     DateTime?   @map("last_crawled_at")
  lastCrawlFailedAt DateTime?   @map("last_crawl_failed_at")

  @@map("publishers")
}

model Summary {
  id          Int           @id @default(autoincrement())
  level       String        @db.VarChar(32)
  content     String
  materialId  String        @map("material_id")
  material    Material      @relation(fields: [materialId], references: [id])
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  translation Translation[]

  @@map("summaries")
}

model Vocabulary {
  id                Int                 @id @default(autoincrement())
  word              String              @db.VarChar(255)
  meaning           String              @db.VarChar(255)
  sentence          String              @db.VarChar(500)
  example           String              @db.VarChar(500)
  pronounce         String              @db.VarChar(255)
  materialId        String              @map("material_id")
  material          Material            @relation(fields: [materialId], references: [id])
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  translation       Translation[]
  savedVocabularies SavedVocabularies[]

  @@unique([word, materialId])
  @@map("vocabularies")
}

model SavedVocabularies {
  id           Int        @id @default(autoincrement())
  vocabularyId Int        @map("vocabulary_id")
  vocabulary   Vocabulary @relation(fields: [vocabularyId], references: [id])
  deleted      Boolean    @default(false)
  archived     Boolean    @default(false)
  userId       String     @map("user_id")
  user         User       @relation(fields: [userId], references: [id])
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@unique([userId, vocabularyId])
  @@map("saved_vocabularies")
}

model Lesson {
  id          Int     @id @default(autoincrement())
  initMessage Boolean @default(false) @map("init_message")

  userId     String    @map("user_id") @db.Char(36)
  user       User      @relation(fields: [userId], references: [id])
  materialId String    @map("material_id")
  material   Material  @relation(fields: [materialId], references: [id])
  messages   Message[]
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@unique([userId, materialId])
  @@map("lessons")
}

model Message {
  id          Int           @id @default(autoincrement())
  content     String        @map("content")
  sentences   Sentence[]
  lesson      Lesson?       @relation(fields: [lessonId], references: [id])
  lessonId    Int?          @map("lesson_id")
  type        String        @default("user")
  createdById String?       @map("created_by_id") @db.Char(36)
  createdBy   User?         @relation(fields: [createdById], references: [id])
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  translation Translation[]

  @@map("messages")
}

model Sentence {
  id              Int              @id @default(autoincrement())
  content         String
  message         Message          @relation(fields: [messageId], references: [id])
  messageId       Int              @map("message_id")
  sentenceIndex   Int              @map("sentence_index")
  paraphrases     Paraphrase[]
  grammarMistakes GrammarMistake[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("sentences")
}

model Paraphrase {
  id         Int       @id @default(autoincrement())
  content    String
  type       String
  sentenceId Int?      @map("sentence_id")
  sentence   Sentence? @relation(fields: [sentenceId], references: [id])

  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  SavedParaphrase SavedParaphrase[]

  @@unique([content, sentenceId])
  @@map("paraphrases")
}

model SavedParaphrase {
  id           Int        @id @default(autoincrement())
  paraphraseId Int        @map("paraphrase_id")
  paraphrase   Paraphrase @relation(fields: [paraphraseId], references: [id])
  userId       String     @map("user_id") @db.Char(36)
  user         User       @relation(fields: [userId], references: [id])
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@unique([userId, paraphraseId])
  @@map("saved_paraphrases")
}

model GrammarMistake {
  id         Int       @id @default(autoincrement())
  content    Json
  type       String
  url        String
  sentenceId Int?      @map("sentence_id")
  sentence   Sentence? @relation(fields: [sentenceId], references: [id])

  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")
  savedGrammarMistake SavedGrammarMistake[]

  @@map("grammar_mistakes")
}

model SavedGrammarMistake {
  id               Int            @id @default(autoincrement())
  grammarMistakeId Int            @map("grammar_mistake_id")
  grammarMistake   GrammarMistake @relation(fields: [grammarMistakeId], references: [id])
  userId           String         @map("user_id") @db.Char(36)
  user             User           @relation(fields: [userId], references: [id])
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  @@unique([userId, grammarMistakeId])
  @@map("saved_grammar_mistakes")
}

model Language {
  id           Int           @id @default(autoincrement())
  code         String        @unique @db.VarChar(10) // e.g., 'en', 'fr', 'es'
  name         String        @unique @db.VarChar(255) // e.g., 'English', 'French', 'Spanish'
  translations Translation[]

  @@map("languages")
}

model Translation {
  id           Int         @id @default(autoincrement())
  language     Language    @relation(fields: [languageId], references: [id])
  languageId   Int
  content      String
  summaryId    Int?        @map("summary_id")
  summary      Summary?    @relation(fields: [summaryId], references: [id])
  vocabularyId Int?        @map("vocabulary_id")
  vocabulary   Vocabulary? @relation(fields: [vocabularyId], references: [id])
  messageId    Int?        @map("message_id")
  message      Message?    @relation(fields: [messageId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("translations")
}

model FollowRss {
  id          Int       @id @default(autoincrement())
  userId      String    @map("user_id") @db.Char(36)
  user        User      @relation(fields: [userId], references: [id])
  publisherId String    @map("publisher_id") @db.Char(36)
  publisher   Publisher @relation(fields: [publisherId], references: [id])
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([userId, publisherId])
  @@map("follow_rss")
}

model Hashtag {
  id              Int                 @id @default(autoincrement())
  name            String              @unique @db.VarChar(255)
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  materialHashtag MaterialHashtag[]
  userHashtag     UserFollowHashtag[]

  @@map("hashtags")
}

model MaterialHashtag {
  id         Int      @id @default(autoincrement())
  materialId String   @map("material_id") @db.Char(36)
  material   Material @relation(fields: [materialId], references: [id])
  hashtagId  Int      @map("hashtag_id")
  hashtag    Hashtag  @relation(fields: [hashtagId], references: [id])
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([materialId, hashtagId])
  @@map("material_hashtags")
}

model UserFollowHashtag {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id") @db.Char(36)
  user      User     @relation(fields: [userId], references: [id])
  hashtagId Int      @map("hashtag_id")
  hashtag   Hashtag  @relation(fields: [hashtagId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, hashtagId])
  @@map("user_follow_hashtags")
}
